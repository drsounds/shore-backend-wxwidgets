@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT TARGET shore::shore)
  find_dependency(shore CONFIG)
endif()
find_dependency(wxWidgets COMPONENTS core base)
include("${wxWidgets_USE_FILE}")
include("${CMAKE_CURRENT_LIST_DIR}/shoreBackendWxWidgetsTargets.cmake")
check_required_components(shore-backend-wxwidgets)
